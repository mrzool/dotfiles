# Run native beets
beet() {
    "$HOME/.local/bin/beet" "$@"
}

# Run containerized beets when needed
beet-docker() {
    docker compose \
        --project-directory "$HOME/Developer/beetbox" \
        run --rm --no-deps beets "$@"
}

# Import albums from slskd or SeeleSeek into the remote music library
beet-import() {
    local slskd="$HOME/Developer/beetbox/data/slskd/downloads"
    local seelseek="$HOME/Downloads/SeeleSeek/Complete"
    local selected source album path

    selected=$(
        {
            [[ -d "$slskd" ]] &&
                find "$slskd" -mindepth 1 -maxdepth 1 -type d \
                    -exec basename {} \; | sed 's/^/slskd | /'

            [[ -d "$seelseek" ]] &&
                find "$seelseek" -mindepth 1 -maxdepth 1 -type d \
                    -exec basename {} \; | sed 's/^/SeeleSeek | /'
        } | fzf --height=60% \
                --reverse \
                --border \
                --prompt='Import album > ' \
                --query="$*"
    ) || return

    source="${selected%% | *}"
    album="${selected#* | }"

    case "$source" in
        slskd)     path="$slskd/$album" ;;
        SeeleSeek) path="$seelseek/$album" ;;
        *)         return 1 ;;
    esac

    beet import -c -t "$path"
}

complete -o filenames -F _beet_import_complete beet-import

# Search albums and show their IDs
beet-search() {
    beet ls -a -f '$id | $albumartist - $album' "$@"
}
